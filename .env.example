# Firebase web app config — copy to .env and fill in from the Firebase console.
# NEVER commit a real .env file. These values are public client config
# (not secrets), but keep them out of the repo anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "true" on localhost so App Check uses the debug provider.
# The debug token printed in the console must be safelisted in
# Firebase console > App Check > Apps > Manage debug tokens.
VITE_APPCHECK_DEBUG=false
